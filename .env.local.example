# Copy this file to .env.local and fill in values from the shared
# ACCY628-FINAL-PROJECT Supabase database (Project Settings → API Keys).
# Use the Project URL and the anon / publishable key.
# Never put a service-role key or database password here.

NEXT_PUBLIC_SUPABASE_URL=https://icymsjpkfddfrbbazxss.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here

# Class demos: password-free demo role switching (login + header switcher).
# Set to "true" for walkthroughs. Leave unset/false for normal password auth.
# NEXT_PUBLIC_DEMO_MODE=true
# Optional override for all demo account passwords (server-only; default 1234)
# DEMO_ACCOUNT_PASSWORD=1234

# Server-only. Required for Admin "Create user". Never expose in the browser.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional — customer-visible ticket summary generation (server-only).
# Do NOT prefix with NEXT_PUBLIC_. Never commit a real key.
# Create a key at https://platform.openai.com/api-keys and paste it into .env.local only.
# If unset, the app uses a clearly labeled non-AI fallback draft from technician notes.
OPENAI_API_KEY=
# Optional model override (default gpt-4o-mini)
# OPENAI_SUMMARY_MODEL=gpt-4o-mini
